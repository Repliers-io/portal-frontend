    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@mui/system": "^7.3.11",
    "@mui/x-date-pickers": "^8.29.0",
    "@next/mdx": "^16.3.1",
    "@next/third-parties": "^16.3.1",
    "@tryghost/content-api": "^1.12.9",
    "@turf/helpers": "^7.3.5",
    "@turf/turf": "^7.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/mdx": "^2.0.14",
    "@types/polylabel": "^1.1.3",
    "@types/three": "^0.180.0",
    "@wordpress/autop": "^4.49.0",
    "addresser": "github:Repliers-io/addresser",
    "autoprefixer": "^10.5.2",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.21",
    "debug": "^4.4.3",
    "deepmerge": "^4.3.1",
    "embla-carousel-react": "^8.6.0",
    "fast-equals": "^6.0.0",
    "geojson": "^0.5.0",
    "he": "^1.2.0",
    "joi": "^17.13.4",
    "js-cookie": "^3.0.8",
    "jwt-decode": "4.0.0",
    "libphonenumber-js": "^1.13.7",
    "mapbox-gl": "3.25.0",
    "marked": "^18.0.5",
    "next": "16.3.1",
    "next-intl": "^4.13.0",
    "p-throttle": "^6.2.0",
    "postcss": "^8.5.15",
    "query-string": "^9.4.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.9.0",
    "redis": "^5.12.1",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.33.5",
    "suncalc": "^1.9.0",
    "supercluster": "^8.0.1",
    "three": "^0.180.0",
    "three-csg-ts": "^3.2.0",
    "threebox-plugin": "^2.2.7",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": "24.x || 26.x"
  },
  "overrides": {},
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.4",
    "@happy-dom/jest-environment": "^20.10.6",
    "@jest/globals": "^30.4.1",
    "@next/bundle-analyzer": "^16.3.1",
    "@next/eslint-plugin-next": "^16.3.1",
    "@playwright/test": "^1.61.1",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/he": "^1.2.3",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
