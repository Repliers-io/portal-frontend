{
  "name": "portal-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "src/components/shared/Map/MapContainer.tsx"
  ],
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "pnpm run prebuild && next dev",
    "build": "pnpm run clean:public && node scripts/build-remote.js",
    "build:documentation": "pnpm run clean:documentation && node scripts/build-documentation.js && pnpm run generate:rewrites",
    "clean:documentation": "rimraf public/documentation && pnpm run generate:rewrites",
    "start": "next start",
    "prebuild": "pnpm run generate:rewrites && pnpm run generate:deployment-id",
    "clean:public": "node scripts/prepare-public.js",
    "eslint": "eslint \"./**/*.{ts,tsx,js}\" && node scripts/check-fork-imports.js --error",
    "type-check": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "jest --coverage=false --no-watch",
    "generate:rewrites": "tsx scripts/generate-rewrites.ts",
    "generate:deployment-id": "node scripts/generate-deployment-id.js"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@growthbook/growthbook": "^1.6.5",
    "@hookform/resolvers": "^4.1.3",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@mdx-js/loader": "^3.1.1",
