# pnpm content-addressable store — only needed during install, not at runtime

.pnpm-store/

# Source code — not needed at runtime (Next.js runs from .next/)

src/

# Build-time scripts — not needed at runtime

scripts/

# Documentation

docs/
_.md
README_

# Webpack/Next.js build cache — only needed during build, not at runtime

.next/cache/

# Tests and coverage

coverage/
**/\*.test.ts
**/_.test.tsx
\*\*/_.spec.ts \*_/_.spec.tsx
jest.config.js
